#!/usr/bin/env bash
# Blocks commits that would publish private or unchecked files. This repo is PUBLIC:
# once something is pushed, assume it has been seen.
# Turn on once per clone:  git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

fail=0
while IFS= read -r f; do
  lower=$(printf '%s' "$f" | tr '[:upper:]' '[:lower:]')
  case "$lower" in
    *.webm|*.mp4|*.mov|*.mkv|*.avi)
      echo "BLOCKED $f: videos stay on the group drive."; fail=1 ;;
    *export.zip|*export.xml|*export_cda.xml|*apple_health_export/*)
      echo "BLOCKED $f: Apple Health exports stay on your computer."; fail=1 ;;
    *consent*)
      echo "BLOCKED $f: consent forms never go on GitHub."; fail=1 ;;
    report/report.md|report/figures/*|report/results/*)
      if [ -z "${GITHUB_ACTIONS:-}" ]; then
        echo "BLOCKED $f: generated by GitHub Actions. Edit report/template.md instead."; fail=1
      fi ;;
  esac
  if [ -f "$f" ] && [ "$(wc -c < "$f")" -gt 26214400 ]; then
    echo "BLOCKED $f: larger than 25 MB."; fail=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR)

if git diff --cached --name-only | grep -q '^data/'; then
  python3 tools/ingest.py check || fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo
  echo "Commit stopped. Unstage the files above (git restore --staged <file>) and try again."
  exit 1
fi
